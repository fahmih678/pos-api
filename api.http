@baseUrl = https://pos-api.test/api

# ==============================================================================
# FASE 1: AUTHENTICATION & PROFILE
# ==============================================================================

### 1.1 Login sebagai Admin
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json

{
    "email": "admin@pos.test",
    "password": "password",
    "device_name": "admin-macbook"
}

###
@adminToken = {{loginAdmin.response.body.data.token}}

### 1.2 Login sebagai Kasir
# @name loginCashier
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json

{
    "email": "cashier@pos.test",
    "password": "password",
    "device_name": "kasir-terminal-1"
}

###
@cashierToken = {{loginCashier.response.body.data.token}}

### 1.3 Lihat Profil Sendiri (/api/me)
GET {{baseUrl}}/me
Accept: application/json
Authorization: Bearer {{cashierToken}}

### 1.4 Logout Kasir (Revoke Token)
POST {{baseUrl}}/logout
Accept: application/json
Authorization: Bearer {{cashierToken}}


# ==============================================================================
# FASE 2: MANAJEMEN KATEGORI & KATALOG PRODUK
# ==============================================================================

### 2.1 Tambah Kategori Baru (Admin / Manager Only)
# @name createCategory
POST {{baseUrl}}/categories
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
    "name": "Minuman Kopi Spesial",
    "description": "Aneka varian olahan biji kopi espresso dan susu"
}

###
@categoryId = {{createCategory.response.body.data.id}}

### 2.2 List Semua Kategori
GET {{baseUrl}}/categories
Accept: application/json
Authorization: Bearer {{cashierToken}}

### 2.3 Tambah Produk Baru (Admin / Manager Only)
# @name createProduct
POST {{baseUrl}}/products
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
    "category_id": 1,
    "sku": "PRD-KOPI-999",
    "barcode": "8991234567999",
    "name": "Kopi Susu Caramel 250ml",
    "description": "Espresso dengan saus caramel dan susu segar",
    "cost_price": 9000,
    "selling_price": 20000,
    "stock": 50,
    "alert_stock_threshold": 10
}

###
@productId = {{createProduct.response.body.data.id}}

### 2.4 Kasir Melihat Daftar Produk (Notice: cost_price disembunyikan dari kasir)
GET {{baseUrl}}/products
Accept: application/json
Authorization: Bearer {{cashierToken}}

### 2.5 Admin Melihat Daftar Produk (Notice: cost_price terlihat)
GET {{baseUrl}}/products
Accept: application/json
Authorization: Bearer {{adminToken}}

### 2.6 Kasir Mencari Produk via Scanner Barcode atau Nama
GET {{baseUrl}}/products?q=8991234567890
Accept: application/json
Authorization: Bearer {{cashierToken}}

### 2.7 Cek Produk dengan Stok Menipis (Low Stock Warning)
GET {{baseUrl}}/products/low-stock
Accept: application/json
Authorization: Bearer {{cashierToken}}


# ==============================================================================
# FASE 3: MANAJEMEN MUTASI STOK & AUDIT TRAIL
# ==============================================================================

### 3.1 Restock Barang Masuk dari Supplier (Admin / Manager Only)
POST {{baseUrl}}/products/1/stock-adjustments
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
    "type": "restock",
    "quantity": 25,
    "notes": "Penerimaan barang dari Supplier CV Berkah Kopi"
}

### 3.2 Catat Barang Rusak / Pecah (Damage)
POST {{baseUrl}}/products/1/stock-adjustments
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
    "type": "damage",
    "quantity": 2,
    "notes": "Botol pecah saat penataan di display depan"
}

### 3.3 Penyesuaian Stok Fisik / Stok Opname (Adjustment)
POST {{baseUrl}}/products/1/stock-adjustments
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
    "type": "adjustment",
    "quantity": 160,
    "notes": "Hasil rekonsiliasi stok opname mingguan"
}

### 3.4 Lihat Kartu Riwayat Mutasi Stok Produk (Stock Card Audit Trail)
GET {{baseUrl}}/products/1/stock-movements
Accept: application/json
Authorization: Bearer {{adminToken}}


# ==============================================================================
# FASE 4: TRANSAKSI PENJUALAN & CHECKOUT KASIR
# ==============================================================================

### 4.1 Kasir Memproses Checkout Penjualan Multi-Item
# @name checkoutOrder
POST {{baseUrl}}/checkout
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{cashierToken}}

{
    "customer_name": "Ahmad Dani",
    "discount_amount": 2000,
    "tax_amount": 1000,
    "notes": "Pesanan Takeaway",
    "items": [
        {
            "product_id": 1,
            "quantity": 2
        },
        {
            "product_id": 2,
            "quantity": 1
        }
    ]
}

###
@orderId = {{checkoutOrder.response.body.data.id}}

### 4.2 Melihat Riwayat Transaksi Penjualan (Kasir & Admin)
GET {{baseUrl}}/orders
Accept: application/json
Authorization: Bearer {{cashierToken}}

### 4.3 Filter Riwayat Transaksi Berdasarkan Status / Nomor Faktur
GET {{baseUrl}}/orders?status=completed&invoice_number=INV
Accept: application/json
Authorization: Bearer {{cashierToken}}

### 4.4 Melihat Detail Satu Faktur Penjualan (Struk Kasir)
GET {{baseUrl}}/orders/{{orderId}}
Accept: application/json
Authorization: Bearer {{cashierToken}}


# ==============================================================================
# FASE 5: PEMBAYARAN KASIR & PEMBATALAN PESANAN (VOID)
# ==============================================================================

### 5.1 Kasir Memproses Pembayaran Tunai (Cash)
POST {{baseUrl}}/orders/{{orderId}}/pay
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{cashierToken}}

{
    "payment_method": "cash",
    "amount_tendered": 50000
}

### 5.2 Kasir Memproses Pembayaran Non-Tunai (QRIS)
POST {{baseUrl}}/orders/{{orderId}}/pay
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{cashierToken}}

{
    "payment_method": "qris",
    "reference_number": "QRIS-BCA-12345678"
}

### 5.3 Manager Membatalkan Pesanan (Void) & Mengembalikan Stok Otomatis
POST {{baseUrl}}/orders/{{orderId}}/void
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
    "reason": "Pelanggan salah memilih pesanan dan ingin refund"
}


# ==============================================================================
# FASE 6: LAPORAN PENJUALAN & ANALISIS BISNIS (ADMIN & MANAGER ONLY)
# ==============================================================================

### 6.1 Ringkasan Omzet, HPP, & Laba Kotor Toko Hari Ini
GET {{baseUrl}}/reports/sales-summary
Accept: application/json
Authorization: Bearer {{adminToken}}

### 6.2 Ringkasan Penjualan dengan Filter Rentang Tanggal
GET {{baseUrl}}/reports/sales-summary?start_date=2026-11-01 00:00:00&end_date=2026-11-30 23:59:59
Accept: application/json
Authorization: Bearer {{adminToken}}

### 6.3 Daftar Produk Terlaris (Top Selling Products)
GET {{baseUrl}}/reports/top-products?limit=5
Accept: application/json
Authorization: Bearer {{adminToken}}
